{
  "manifest_version": 3,
  "name": "Registro Rápido - Transferencias",
  "version": "1.2",
  "description": "Envía recibos de WU, MG, Ria, Mondial y Monty directo al sistema de control.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "capturar_recibo": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Capturar recibo de la página actual y registrar transferencia"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Registro Rápido de Transferencias",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
